<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% block title %}Default Title{% endblock %} - REON</title>
		<meta name="description" content="{% block meta_description %}REON — a recreation of the Mobile GB System, the online service reached by connecting a Game Boy Color through the Mobile Adapter.{% endblock %}">
		<meta name="theme-color" content="#1272b0">
		<link rel="icon" href="{{ asset('/images/REON_Logo.svg') }}" type="image/svg+xml">
		<meta property="og:site_name" content="REON">
		<meta property="og:title" content="{% block og_title %}REON — The Mobile GB System{% endblock %}">
		<meta property="og:description" content="A recreation of the Game Boy Color's Mobile Adapter online service.">
		<meta property="og:type" content="website">
		<meta property="og:image" content="{{ asset('/images/REON_Logo.svg') }}">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
		<link href="{{ asset('/css/mobile-trainer.css') }}" rel="stylesheet">
		<link href="{{ asset('/css/main.css') }}" rel="stylesheet">
		<link href="{{ asset('/css/reon-theme.css') }}" rel="stylesheet">
		{# For scripts that post on their own (fetch) rather than through a
		   form: they read the token here and send it under the same field. #}
		<meta name="csrf-token" content="{{ csrf_token }}">
		<meta name="csrf-field" content="{{ csrf_field }}">
		{% block head %}
		{% endblock %}
	</head>
	{# data-section names the portal area this page belongs to. The CSS turns it
	   into --section-gem, so the header dot picks up the same colour as the
	   section's gem in the side menu instead of always being blue. #}
	<body{% if body_class is defined and body_class %} class="{{ body_class|e('html_attr') }}"{% endif %}{% if nav_item is defined and nav_item %} data-section="{{ nav_item|e('html_attr') }}"{% endif %}>
		<header class="navbar navbar-expand-lg bg-body-tertiary cgb-gradient-border container-xxl">
			<nav class="container-xxl">
				<a href="/index.php" class="navbar-brand">
					<img src="/images/REON_Logo.svg" alt="REON" class="reon-navbar-logo">
				</a>

				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#reonNavbar" aria-controls="reonNavbar" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="collapse navbar-collapse" id="reonNavbar">
				<ul class="navbar-nav me-auto mb-2 mb-lg-0">
					<li class="nav-item"><a href="/index.php" class="nav-link{% if nav_item == 'index' %}{{ ' active' }}{% endif %}" aria-current="page">{{'home'|trans}}</a></li>
					<li class="nav-item"><a href="/news.php" class="nav-link{% if nav_item == 'news' %}{{ ' active' }}{% endif %}">{{'news'|trans}}</a></li>
					<li class="nav-item dropdown">
						<a href="#" class="nav-link dropdown-toggle{% if nav_item == 'games' %}{{ ' active' }}{% endif %}" id="gamesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
							{{'games'|trans}}
						</a>
						<ul class="dropdown-menu" aria-labelledby="gamesDropdown">
							<li><a class="dropdown-item" href="/mariokart/">{{'mario-kart.title'|trans}}</a></li>
							<li><a class="dropdown-item" href="/pokemon/">{{'pokemon-crystal'|trans}}</a></li>
							<li><a class="dropdown-item" href="/gbwars/">{{'gameboy-wars'|trans}}</a></li>
						</ul>
					</li>
					<li class="nav-item"><a href="/guide.php" class="nav-link{% if nav_item == 'guide' %}{{ ' active' }}{% endif %}">{{'guide'|trans}}</a></li>
					<li class="nav-item"><a href="/downloads.php" class="nav-link{% if nav_item == 'downloads' %}{{ ' active' }}{% endif %}">{{'downloads'|trans}}</a></li>
					<li class="nav-item"><a href="#" class="nav-link" onclick="openGbcModal(); return false;">{{'mobile-home'|trans}}</a></li>
				</ul>
				
				<ul class="navbar-nav mb-2 mb-lg-0 align-items-lg-center reon-navbar-actions">
						<li class="nav-item dropdown locale-nav-item">
							<a href="#" class="nav-link dropdown-toggle" id="localeDropdown" role="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
								{% set lang_tmpl = 'locale.' ~ curr_locale %}{{ lang_tmpl|trans }}
							</a>
							<ul id="localeDropdownMenu" class="dropdown-menu locale-dropdown-menu" aria-labelledby="localeDropdown">
								<li><a class="dropdown-item" href="?lang=en" data-locale-code="en">{{'locale.en'|trans}}</a></li>
								<li><a class="dropdown-item" href="?lang=ja" data-locale-code="ja">{{'locale.ja'|trans}}</a></li>
								<li><a class="dropdown-item" href="?lang=de" data-locale-code="de">{{'locale.de'|trans}}</a></li>
								<li><a class="dropdown-item" href="?lang=es" data-locale-code="es">{{'locale.es'|trans}}</a></li>
								<li><a class="dropdown-item" href="?lang=it" data-locale-code="it">{{'locale.it'|trans}}</a></li>
								<li><a class="dropdown-item" href="?lang=fr" data-locale-code="fr">{{'locale.fr'|trans}}</a></li>
								<li><a class="dropdown-item" href="?lang=pt-br" data-locale-code="pt-br">{{'locale.pt-br'|trans}}</a></li>
							</ul>
						</li>
						{% if session_active %}
							{# Grouped into one dropdown: as nav entries were added the two
							   separate buttons pushed the bar into wrapping onto two lines. #}
							<li class="nav-item dropdown">
								<a href="#" class="nav-link dropdown-toggle" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
									{{ curr_username|default('your-account'|trans) }}
									{#- The count also sits on the Mail item inside, but the menu is
									    closed by default, so nothing there is visible until you go
									    looking. This is the one that has to catch the eye. -#}
									{#- Only unread mail earns a badge: the count of new messages,
									    in the accent colour. The whole-mailbox total used to show in
									    grey once nothing was unread; the owner had it removed. -#}
									{#- The wrapper is always present, even with nothing to show:
									    mail-indicator.js rewrites its contents every minute, and
									    needs somewhere to put a badge that did not exist at load. -#}
									<span data-mail-badge>
									{%- if mail_new > 0 %}
										<span class="mail-badge mail-badge--new"
										      title="{{ 'mail.new-arrived'|trans({'%count%': mail_new}) }}">{{ mail_new }}</span>
										<span class="visually-hidden">{{ 'mail.new-arrived'|trans({'%count%': mail_new}) }}</span>
									{% endif -%}
									{%- if mail_game_waiting|default(0) > 0 %}
										<span class="mail-badge mail-badge--game"
										      title="{{ 'mail.game-waiting'|trans({'%count%': mail_game_waiting}) }}">{{ mail_game_waiting }}</span>
										<span class="visually-hidden">{{ 'mail.game-waiting'|trans({'%count%': mail_game_waiting}) }}</span>
									{% endif -%}
									</span>
								</a>
								<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountDropdown">
									<li><a class="dropdown-item" href="/user/summary.php">{{'your-account'|trans}}</a></li>
									<li><a class="dropdown-item" href="/user/mail.php">
										{{'mail.title'|trans}}<span data-mail-badge>
										{%- if mail_new > 0 %} <span class="mail-badge mail-badge--new">{{ mail_new }}</span>{% endif -%}
										{%- if mail_game_waiting|default(0) > 0 %} <span class="mail-badge mail-badge--game" title="{{ 'mail.game-waiting'|trans({'%count%': mail_game_waiting}) }}">{{ mail_game_waiting }}</span>{% endif -%}
										</span>
									</a></li>
									<li><hr class="dropdown-divider"></li>
									<li><a class="dropdown-item" href="/logout.php">{{'logout'|trans}}</a></li>
								</ul>
							</li>
						{% else %}
							<li class="nav-item"><a href="/login.php" class="btn btn-outline-primary me-2">{{'login'|trans}}</a></li>
							<li class="nav-item"><a href="/signup.php" class="btn btn-primary">{{'signup'|trans}}</a></li>
						{% endif %}
					</ul>
				</div>
			</nav>
		</header>
		
		<div class="container-xxl">
			<div class="reon-ticker">
				<span class="reon-ticker__label">{{'news'|trans}}</span>
				<marquee class="reon-ticker__scroll">{{'welcome-alpha'|trans}}</marquee>
			</div>
		</div>
		
		<main id="content" class="container-xxl mt-3 my-md-4">{% block content %}Default Content{% endblock %}</main>
		
		{% block body %}
		{% endblock %}

		{% if show_passport_modal %}
			{% include "_passport_modal.twig" %}
		{% endif %}

		<!-- GBC Mobile Trainer Modal -->
		<div id="gbc-modal" class="gbc-modal-overlay" onclick="closeGbcModal(event)">
			<div class="gbc-modal-content" onclick="event.stopPropagation()">
				<button class="gbc-modal-close" onclick="closeGbcModal()" aria-label="Close">&times;</button>
				<div class="gbc-frame-container gbc-large">
					<div class="gbc-frame-screen">
						<iframe id="gbc-iframe" class="gbc-frame-iframe" title="Mobile Trainer"></iframe>
					</div>
					<img class="gbc-frame-svg" src="/images/cgb/CGB_Transparent_Screen.svg" alt="Game Boy Color">
					<!-- the link cable runs off the connector to a REON adapter that trails off-screen -->
					<div class="gbc-link-rig" aria-hidden="true">
						<img class="gbc-link-rig__adapter" src="/images/mobile_adapter/REON_Blue_Adapter_Horizontal.svg" alt="">
						<span class="gbc-link-rig__cable"></span>
					</div>
				</div>
			</div>
		</div>

		<script>
			function openGbcModal() {
				var modal = document.getElementById('gbc-modal');
				var iframe = document.getElementById('gbc-iframe');
				// Inject styles when iframe loads
				iframe.onload = function() {
					try { iframe.contentWindow.focus(); } catch (e) {}
				};
				// Load the iframe content only when opening (versioned so edits aren't cached)
				iframe.src = '{{ asset('/cgb/trainer.html') }}';
				modal.classList.add('active');
				document.body.style.overflow = 'hidden';
			}

			function injectGbcStyles(iframe) {
				try {
					var doc = iframe.contentDocument || iframe.contentWindow.document;
					// Inject stylesheet link
					var link = doc.createElement('link');
					link.rel = 'stylesheet';
					link.href = '/css/mobile-trainer.css';
					doc.head.appendChild(link);
					// Add the gbc-screen class to the body for styling
					doc.body.classList.add('gbc-screen');
				} catch (e) {
					console.warn('Could not inject styles into iframe:', e);
				}
			}

			function alignGbcScreen() {
				// Round screen position to integer pixels to prevent blurry text
				var screen = document.querySelector('.gbc-frame-screen');
				if (!screen) return;
				var rect = screen.getBoundingClientRect();
				var offsetX = rect.left - Math.round(rect.left);
				var offsetY = rect.top - Math.round(rect.top);
				if (offsetX !== 0 || offsetY !== 0) {
					// Apply sub-pixel correction via transform
					screen.style.transform = 'translate(' + (-offsetX) + 'px, ' + (-offsetY) + 'px) translateZ(0)';
				}
			}

			function closeGbcModal(event) {
				// If called from overlay click, only close if clicking the overlay itself
				if (event && event.target !== event.currentTarget) return;
				var modal = document.getElementById('gbc-modal');
				var iframe = document.getElementById('gbc-iframe');
				modal.classList.remove('active');
				document.body.style.overflow = '';
				// Clear iframe to stop any media
				iframe.src = 'about:blank';
			}

			// Close on Escape key
			document.addEventListener('keydown', function(e) {
				if (e.key === 'Escape') closeGbcModal();
			});

			(function localeDropdownLayerFix() {
				function init() {
					var toggle = document.getElementById('localeDropdown');
					var menu = document.getElementById('localeDropdownMenu');
					if (!toggle || !menu) return;
					var menuPlaceholder = null;
					var originalParent = menu.parentNode;

					function positionMenu() {
						var rect = toggle.getBoundingClientRect();
						var spacer = 2;
						var contentWidth = Math.ceil(menu.scrollWidth || 0);
						var minWidth = Math.max(Math.ceil(rect.width), contentWidth);
						var maxLeft = Math.max(4, window.innerWidth - minWidth - 4);
						var left = Math.max(4, Math.min(Math.round(rect.left), maxLeft));

						menu.style.setProperty('position', 'fixed', 'important');
						menu.style.setProperty('left', left + 'px', 'important');
						menu.style.setProperty('top', Math.round(rect.bottom + spacer) + 'px', 'important');
						menu.style.setProperty('right', 'auto', 'important');
						menu.style.setProperty('margin-top', '0', 'important');
						menu.style.setProperty('transform', 'none', 'important');
						menu.style.setProperty('min-width', minWidth + 'px', 'important');
						menu.style.setProperty('z-index', '30', 'important');
						menu.style.setProperty('pointer-events', 'auto', 'important');
					}

					function mountToBody() {
						if (menu.parentNode === document.body) return;
						menuPlaceholder = document.createComment('locale-dropdown-placeholder');
						if (menu.parentNode) {
							menu.parentNode.insertBefore(menuPlaceholder, menu);
						}
						document.body.appendChild(menu);
						menu.classList.add('locale-dropdown-floating');
					}

					function restoreToNavbar() {
						if (menu.parentNode !== document.body) return;
						menu.classList.remove('locale-dropdown-floating');
						if (menuPlaceholder && menuPlaceholder.parentNode) {
							menuPlaceholder.parentNode.insertBefore(menu, menuPlaceholder);
							menuPlaceholder.parentNode.removeChild(menuPlaceholder);
							menuPlaceholder = null;
						} else if (originalParent) {
							originalParent.appendChild(menu);
						}
					}

					function ensureTopLayer() {
						mountToBody();
						positionMenu();
					}

					toggle.addEventListener('show.bs.dropdown', function() {
						document.body.classList.add('locale-menu-open');
						ensureTopLayer();
					});
					toggle.addEventListener('shown.bs.dropdown', ensureTopLayer);

					window.addEventListener('resize', function() {
						if (menu.classList.contains('show')) {
							positionMenu();
						}
					}, { passive: true });

					window.addEventListener('scroll', function() {
						if (menu.classList.contains('show')) {
							positionMenu();
						}
					}, { passive: true });

					toggle.addEventListener('hidden.bs.dropdown', function() {
						document.body.classList.remove('locale-menu-open');
						restoreToNavbar();
					});
				}

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', init);
				} else {
					init();
				}
			})();

		</script>

		{# Strings are handed to the script rather than hardcoded in it, so
		   the toggle and the Caps Lock warning follow the site's language. #}
		<script>
			window.REON_PASSWORD_STRINGS = {
				show: {{ 'password-show'|trans|json_encode|raw }},
				hide: {{ 'password-hide'|trans|json_encode|raw }},
				caps: {{ 'password-caps-on'|trans|json_encode|raw }},
				rulesLabel: {{ 'password-rules-label'|trans|json_encode|raw }}
			};
			{# The numbers come from UserUtil, so the checklist can't promise
			   something different from what the validator enforces. #}
			window.REON_PASSWORD_RULES = [
				{ kind: "min", value: {{ password_min }}, label: {{ 'password-rule-min'|trans({'%count%': password_min})|json_encode|raw }} },
				{ kind: "max", value: {{ password_max }}, label: {{ 'password-rule-max'|trans({'%count%': password_max})|json_encode|raw }} }
			];
		</script>
		<script src="{{ asset('/js/password-field.js') }}"></script>

		{% if session_active %}
		{# Same idea for the mail badges: the strings the script needs to
		   rebuild a badge, in the site's language. Signed-in only -- there is
		   no mailbox to watch otherwise, and the endpoint answers 401. #}
		<script>
			window.REON_MAIL_STRINGS = {
				newArrived: {{ 'mail.new-arrived'|trans|json_encode|raw }},
				gameWaiting: {{ 'mail.game-waiting'|trans|json_encode|raw }},
				inInbox: {{ 'account.emails-in-inbox'|trans|json_encode|raw }}
			};
		</script>
		<script src="{{ asset('/js/mail-indicator.js') }}"></script>
		{% endif %}

	</body>
</html>
