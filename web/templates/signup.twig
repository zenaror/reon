{% extends "main.twig" %}

{% block title %}{{'signup'|trans}}{% endblock %}

{% block head %}
	{# Legal modal bodies use the document-page HTML and its note/box styles. Load them here
	   because the general main template does not otherwise display Markdown document bodies. #}
	<link href="{{ asset('/css/pages.css') }}" rel="stylesheet">
{% endblock %}
{% block content %}
	<div class="d-flex">
		{% if result != 0 %}
			<div class="card m-auto">
				<form method="post" accept-charset="utf-8" class="card-body">
					<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
					{% if result == 3 %}
						<div class="alert alert-danger">{{'email-send-failed'|trans}}</div>
					{% endif %}
					<fieldset>
						<legend>{{'auth.signup-to-reon'|trans}}</legend>
						<div class="mb-3">
							<label for="email" class="form-label">{{'email-addr'|trans}}</label>
							<input id="email" type="email" name="email" required class="form-control{% if result == 2 %}{{ " is-invalid" }}{% endif %}" value="{{ email|e }}">
							<div class="invalid-feedback">
								{{'invalid-email'|trans}}
							</div>
						</div>
						<div class="mb-3">
							<div class="form-check">
								<label for="agree" class="form-check-label">
									{{'auth.i-agree-terms'|trans}}
								</label>
								{# Link the two referenced legal documents outside the translated consent phrase to avoid
								   embedding fragile markup in every locale. Open embedded modals without leaving signup or
								   losing the entered email. #}
								<div class="form-text">
									<a href="/terms.php" data-bs-toggle="modal" data-bs-target="#termsModal">{{'terms'|trans}}</a>
									·
									<a href="/privacy.php" data-bs-toggle="modal" data-bs-target="#privacyModal">{{'privacy'|trans}}</a>
								</div>
								<input id="agree" type="checkbox" name="agree" required class="form-check-input{% if result == 1 %}{{ " is-invalid" }}{% endif %}">
								<div class="invalid-feedback">
									{{'auth.you-must-agree'|trans}}
								</div>
							</div>
						</div>
						<button type="submit" class="btn btn-primary">{{'continue'|trans}}</button>
					</fieldset>
				</form>
			</div>
		{% else %}
			<div class="alert alert-success m-auto">
				{{'auth.registration-email-sent'|trans}}
			</div>
		{% endif %}
	</div>

	{# Fora do <form>: um modal dentro dele entra no POST e, pior, o botão de
	   fechar contaria como submit. #}
	{% include "_legal_modal.twig" with {
		id: "termsModal", title: 'terms'|trans, body: terms_html, href: "/terms.php"
	} only %}
	{% include "_legal_modal.twig" with {
		id: "privacyModal", title: 'privacy'|trans, body: privacy_html, href: "/privacy.php"
	} only %}
{% endblock %}
