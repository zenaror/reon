{% extends "admin/layout.twig" %}

{% block admin_title %}{{ 'admin.logs-title'|trans }}{% endblock %}

{% block admin_body %}
	<form class="admin-form__row mb-3" method="get">
		<label>
			{{ 'admin.logs-service'|trans }}
			<select name="unit">
				{% for name, meta in units %}
					<option value="{{ name }}"{% if name == unit %} selected{% endif %}>{{ meta.label }}</option>
				{% endfor %}
			</select>
		</label>
		<label>
			{{ 'admin.logs-lines'|trans }}
			<select name="lines">
				{% for n in [50, 100, 200, 500, 1000] %}
					<option value="{{ n }}"{% if n == lines %} selected{% endif %}>{{ n }}</option>
				{% endfor %}
			</select>
		</label>
		<button class="btn btn-outline-primary" type="submit">{{ 'admin.logs-show'|trans }}</button>
	</form>

	{% if not available %}
		<p class="admin-notice admin-notice--bad">{{ 'admin.logs-unavailable'|trans }}</p>
	{% elseif text is empty %}
		<p>{{ 'admin.logs-empty'|trans }}</p>
	{% else %}
		<pre class="admin-console">{{ text }}</pre>
	{% endif %}
{% endblock %}
