{% extends "admin/layout.twig" %}

{% block admin_title %}{{ 'admin.logs-title'|trans }}{% endblock %}

{% block admin_body %}
	<form class="admin-form__row mb-3" method="get">
		<label>
			{{ 'admin.logs-service'|trans }}
			<select name="unit">
				{% for name, meta in units %}
					<option value="{{ name }}"{% if name == unit %} selected{% endif %}>{{ meta.label }}</option>
				{% endfor %}
			</select>
		</label>
		<label>
			{{ 'admin.logs-lines'|trans }}
			<select name="lines">
				{% for n in [50, 100, 200, 500, 1000] %}
					<option value="{{ n }}"{% if n == lines %} selected{% endif %}>{{ n }}</option>
				{% endfor %}
			</select>
		</label>
		<label>
			{{ 'admin.logs-level'|trans }}
			<select name="level">
				<option value=""{% if level == '' %} selected{% endif %}>{{ 'admin.logs-level-all'|trans }}</option>
				<option value="warn"{% if level == 'warn' %} selected{% endif %}>{{ 'admin.logs-level-warn'|trans }}</option>
				<option value="error"{% if level == 'error' %} selected{% endif %}>{{ 'admin.logs-level-error'|trans }}</option>
			</select>
		</label>
		<label>
			<input type="checkbox" name="raw" value="1"{% if raw %} checked{% endif %}>
			{{ 'admin.logs-raw'|trans }}
		</label>
		<button class="btn btn-outline-primary" type="submit">{{ 'admin.logs-show'|trans }}</button>
	</form>

	{% if not available and is_file %}
		<div class="admin-notice admin-notice--bad">
			<p class="mb-0"><strong>{{ 'admin.logs-file-unreadable'|trans }}</strong></p>
		</div>
	{% elseif not available %}
		{# The command is here rather than a bare "not enabled": joining the
		   journal group grants reading and nothing else, which is a much
		   smaller thing to hand out than the sudo rule the Services page
		   needs. Someone who wants logs should not have to grant restarts. #}
		<div class="admin-notice admin-notice--bad">
			<p class="mb-1"><strong>{{ 'admin.logs-unavailable'|trans }}</strong></p>
			<p class="mb-1">{{ 'admin.logs-unavailable-why'|trans({'%user%': web_user}) }}</p>
			<pre class="admin-console mb-0">sudo usermod -aG systemd-journal {{ web_user }}
sudo systemctl restart php8.5-fpm</pre>
		</div>
	{% elseif text is empty %}
		<p>{{ 'admin.logs-empty'|trans }}</p>
	{% elseif raw %}
		<pre class="admin-console">{{ text }}</pre>
	{% elseif entries is empty %}
		<p>{{ 'admin.logs-empty'|trans }}</p>
	{% else %}
		{# One row per entry. The level is a word as well as a colour, so it
		   reads without telling red from amber; a stack trace is folded
		   under the message it belongs to. #}
		<div class="log-view" role="table">
			{% for e in entries %}
				<div class="log-row" role="row">
					<span class="log-time" role="cell">{{ e.time }}</span>
					<span class="log-level log-level--{{ e.level ?: 'none' }}" role="cell">{{ e.level }}</span>
					<span class="log-where" role="cell">{{ e.component ?: e.source }}</span>
					<span class="log-msg" role="cell">{{ e.msg }}
						{% if e.extra %}<details><summary>{{ 'admin.logs-details'|trans }}</summary><pre>{{ e.extra }}</pre></details>{% endif %}
					</span>
				</div>
			{% endfor %}
		</div>
	{% endif %}
{% endblock %}
