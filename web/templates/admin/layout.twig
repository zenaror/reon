{% extends "main.twig" %}

{# The panel's shell: one sidebar, one working area, and a title the module
   fills in. Every module extends this rather than main.twig directly, so a
   new module cannot end up without the navigation -- or, worse, look like a
   normal page of the site while it holds a Ban button. #}

{% block title %}{{ 'admin.panel'|trans }} — {% block admin_title %}{% endblock %}{% endblock %}

{% block head %}
	<link href="{{ asset('/css/admin.css') }}" rel="stylesheet">
	{% block admin_head %}{% endblock %}
{% endblock %}

{% block content %}
	{% set path = current_path|default('/') %}
	<div class="admin-shell">
		<aside class="admin-nav">
			<h2 class="admin-nav__title">{{ 'admin.panel'|trans }}</h2>
			<nav>
				<ul class="admin-nav__list">
					{# "Game Content" replaces separate top-level items for each
					   game's own pages (Pokémon News, Mobile Stadium, Mobile
					   Stadium Replays, Mobile Trainer) with one entry that opens
					   a game picker (admin/games.php) -- owner's request,
					   2026-09-28: "Crystal já tem 2 telas só dele... ainda tem o
					   GB Wars também". Tournament and every other non-per-game
					   page stays exactly where it was; only the per-game pages
					   moved. "News" (news.php) does NOT belong here even though
					   its old nav label sat right next to "Pokémon News" --
					   it manages the SITE's own news (NewsUtil, the homepage
					   ticker), not anything Crystal-specific (owner's
					   correction, 2026-09-28: it was wrongly filed under
					   Crystal with Pokémon News' own description on the first
					   pass). match is a list here because the item should stay
					   highlighted on every page that belongs under it, not only
					   on games.php itself. #}
					{% set items = [
						{ href: '/admin/index.php',         key: 'admin.nav-dashboard',     match: ['/admin/index.php'] },
						{ href: '/admin/news.php',          key: 'admin.nav-news',          match: ['/admin/news.php'] },
						{ href: '/admin/games.php',         key: 'admin.nav-game-content',  match: ['/admin/games.php', '/admin/news_maker.php', '/admin/stadium.php', '/admin/stadium_replays.php', '/admin/trainer.php', '/admin/gbwars_maps.php', '/admin/gbwars_map_editor.php', '/admin/gbwars_mercs.php', '/admin/gbwars_mbox.php'] },
						{ href: '/admin/notifications.php', key: 'admin.nav-notifications', match: ['/admin/notifications.php'] },
						{ href: '/admin/users.php',         key: 'admin.nav-users',         match: ['/admin/users.php', '/admin/reserved_names.php'] },
						{ href: '/admin/services.php',      key: 'admin.nav-services',      match: ['/admin/services.php'] },
						{ href: '/admin/adapter.php',       key: 'admin.nav-adapter',       match: ['/admin/adapter.php'] },
						{ href: '/admin/tournament.php',    key: 'admin.nav-tournament',    match: ['/admin/tournament.php'] },
						{ href: '/admin/logs.php',          key: 'admin.nav-logs',          match: ['/admin/logs.php'] },
						{ href: '/admin/log.php',           key: 'admin.nav-audit',         match: ['/admin/log.php'] }
					] %}
					{% for item in items %}
						<li>
							<a class="admin-nav__link{{ path in item.match ? ' is-here' : '' }}" href="{{ item.href }}">{{ item.key|trans }}</a>
						</li>
					{% endfor %}
				</ul>
			</nav>
		</aside>

		<div class="admin-main">
			<header class="admin-main__head">
				<h1 class="h4 mb-0">{{ block('admin_title') }}</h1>
				{% block admin_actions %}{% endblock %}
			</header>

			{% if notice is defined and notice %}
				<p class="admin-notice admin-notice--{{ notice_kind|default('ok') }}">{{ notice }}</p>
			{% endif %}

			{% block admin_body %}{% endblock %}
		</div>
	</div>
{% endblock %}
