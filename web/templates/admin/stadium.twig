{% extends "admin/layout.twig" %}

{% block admin_title %}{{ 'admin.stadium-title'|trans }}{% endblock %}

{% block admin_body %}
	<p class="admin-form__hint">{{ 'admin.stadium-intro'|trans }}</p>
	<p class="admin-form__hint"><a href="/admin/stadium_replays.php">{{ 'admin.stadium-replays-link'|trans }}</a></p>

	<nav class="admin-tabs">
		{% for r in regions %}
			<a class="admin-tabs__link{{ r == region ? ' is-here' : '' }}"
			   href="/admin/stadium.php?region={{ r }}">{{ r|upper }}</a>
		{% endfor %}
	</nav>

	{% if notice %}
		<p class="admin-form__hint admin-form__hint--{{ notice_kind }}">{{ notice }}</p>
	{% endif %}

	{% if distributions is empty %}
		<p class="admin-form__hint">{{ 'admin.stadium-empty'|trans }}</p>
	{% else %}
		<table class="admin-table">
			<thead>
				<tr>
					<th>{{ 'admin.stadium-when'|trans }}</th>
					<th>{{ 'admin.stadium-track'|trans }}</th>
					<th>{{ 'admin.stadium-slug'|trans }}</th>
					<th>{{ 'admin.stadium-cost'|trans }}</th>
					<th>{{ 'admin.stadium-size'|trans }}</th>
					<th>{{ 'admin.stadium-title-col'|trans }}</th>
					<th>{{ 'admin.stadium-active'|trans }}</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{% for d in distributions %}
					<tr>
						<td>{{ d.created_at }}</td>
						<td>
							{% if d.is_custom %}
								<span class="admin-badge">{{ 'admin.stadium-track-custom'|trans }}</span>
							{% else %}
								<span class="admin-badge admin-badge--ok">{{ 'admin.stadium-track-official'|trans }}</span>
							{% endif %}
						</td>
						<td><code>{{ d.slug }}</code></td>
						<td>
							{% if d.cost is null %}
								<span class="admin-form__hint">{{ 'admin.stadium-cost-none'|trans }}</span>
							{% else %}
								{{ d.cost }}
							{% endif %}
						</td>
						<td>{{ d.payload_size }}</td>
						<td>{{ d.title|default('—') }}</td>
						<td>
							{% if d.active %}
								<span class="admin-badge admin-badge--ok">{{ 'admin.stadium-active-yes'|trans }}</span>
							{% else %}
								<span class="admin-badge">{{ 'admin.stadium-active-no'|trans }}</span>
							{% endif %}
						</td>
						<td>
							<form method="post" action="/admin/stadium.php?region={{ region }}">
								<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
								<input type="hidden" name="form_action" value="activate">
								<input type="hidden" name="id" value="{{ d.id }}">
								<input type="hidden" name="action" value="{{ d.active ? 'deactivate' : 'activate' }}">
								<button class="admin-btn admin-btn--small" type="submit">
									{{ (d.active ? 'admin.stadium-deactivate' : 'admin.stadium-activate')|trans }}
								</button>
							</form>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
		{# Activating a row now deactivates any other active row for the
		   same region and track automatically -- at most one active
		   distribution per region (owner's request, 2026-09-28). #}
		<p class="admin-form__hint">{{ 'admin.stadium-order-note'|trans }}</p>
	{% endif %}

	<hr>

	<h3>{{ 'admin.stadium-compose-section-title'|trans }}</h3>
	<p class="admin-form__hint">{{ 'admin.stadium-compose-intro'|trans }}</p>

	{% if replays is empty %}
		<p class="admin-form__hint">{{ 'admin.stadium-compose-empty'|trans }}</p>
	{% else %}
		<form method="post" action="/admin/stadium.php?region={{ region }}">
			<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
			<input type="hidden" name="form_action" value="compose">

			<div class="admin-form__field">
				<label>{{ 'admin.stadium-compose-slots'|trans }}</label>
				<div class="admin-form__stacked">
					{% for n in [1, 2, 3] %}
						<select name="slot{{ n }}">
							<option value="">{{ 'admin.stadium-compose-slot-none'|trans }}</option>
							{% for r in replays %}
								<option value="{{ r.id }}">#{{ r.id }} — {{ r.is_custom ? ('admin.stadium-track-custom'|trans) : ('admin.stadium-track-official'|trans) }} — {{ r.label }}</option>
							{% endfor %}
						</select>
					{% endfor %}
				</div>
				<p class="admin-form__hint">{{ 'admin.stadium-compose-slots-hint'|trans }}</p>
			</div>

			<div class="admin-form__field">
				<label><input type="checkbox" id="compose_is_custom" name="compose_is_custom" value="1"> {{ 'admin.stadium-compose-is-custom'|trans }}</label>
				<p class="admin-form__hint">{{ 'admin.stadium-compose-is-custom-hint'|trans }}</p>
			</div>

			<div class="admin-form__field">
				<label for="message">{{ 'admin.stadium-compose-message'|trans }}</label>
				<textarea id="message" name="message" rows="4"></textarea>
				<p class="admin-form__hint">
					{{ (format == 'j' ? 'admin.stadium-compose-message-hint-j' : 'admin.stadium-compose-message-hint-w')|trans }}
				</p>
			</div>

			<div class="admin-form__field">
				<label>{{ 'admin.stadium-compose-flags'|trans }}</label>
				<label><input type="checkbox" name="flag_gb_to_gba" value="1"> {{ 'admin.stadium-compose-flag-gba'|trans }}</label>
				<label><input type="checkbox" name="flag_n64_to_gc" value="1"> {{ 'admin.stadium-compose-flag-gc'|trans }}</label>
				<p class="admin-form__hint admin-form__hint--bad">{{ 'admin.stadium-compose-flags-warning'|trans }}</p>
			</div>

			<div class="admin-form__field">
				<label for="cost_kind">{{ 'admin.stadium-compose-cost'|trans }}</label>
				<select id="cost_kind" name="cost_kind">
					<option value="none">{{ 'admin.stadium-compose-cost-none'|trans }}</option>
					<option value="zero" selected>{{ 'admin.stadium-compose-cost-zero'|trans }}</option>
					<option value="n">{{ 'admin.stadium-compose-cost-n'|trans }}</option>
				</select>
				<input type="number" name="cost_n" min="1" max="999" placeholder="1-999">
			</div>

			<div class="admin-form__field">
				<label for="slug">{{ 'admin.stadium-compose-slug'|trans }}</label>
				<input type="text" id="slug" name="slug" pattern="[a-z0-9-]{1,40}" required>
			</div>

			<div class="admin-form__field">
				<label for="title">{{ 'admin.stadium-compose-title-field'|trans }}</label>
				<input type="text" id="title" name="title" maxlength="120">
			</div>

			<button class="admin-btn" type="submit">{{ 'admin.stadium-compose-submit'|trans }}</button>
		</form>
	{% endif %}
{% endblock %}
