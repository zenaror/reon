{% extends "admin/layout.twig" %}

{% block admin_title %}{{ 'admin.stadium-title'|trans }}{% endblock %}

{% block admin_body %}
	<p class="admin-form__hint">{{ 'admin.stadium-intro'|trans }}</p>
	{# O que este painel NÃO faz: gerar o binário. O bloco de 0xFFE bytes vem
	   pronto do lado de quem monta a batalha -- entra por importação, não
	   digitado aqui. O painel só lista o que existe e diz o que está no ar. #}
	<p class="admin-form__hint">{{ 'admin.stadium-no-generator'|trans }}</p>

	<nav class="admin-tabs">
		{% for r in regions %}
			<a class="admin-tabs__link{{ r == region ? ' is-here' : '' }}"
			   href="/admin/stadium.php?region={{ r }}">{{ r|upper }}</a>
		{% endfor %}
	</nav>

	{% if notice %}
		<p class="admin-form__hint admin-form__hint--{{ notice_kind }}">{{ notice }}</p>
	{% endif %}

	{% if distributions is empty %}
		<p class="admin-form__hint">{{ 'admin.stadium-empty'|trans }}</p>
	{% else %}
		<table class="admin-table">
			<thead>
				<tr>
					<th>{{ 'admin.stadium-when'|trans }}</th>
					<th>{{ 'admin.stadium-slug'|trans }}</th>
					<th>{{ 'admin.stadium-cost'|trans }}</th>
					<th>{{ 'admin.stadium-size'|trans }}</th>
					<th>{{ 'admin.stadium-title-col'|trans }}</th>
					<th>{{ 'admin.stadium-active'|trans }}</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{% for d in distributions %}
					<tr>
						<td>{{ d.created_at }}</td>
						<td><code>{{ d.slug }}</code></td>
						<td>
							{% if d.cost is null %}
								<span class="admin-form__hint">{{ 'admin.stadium-cost-none'|trans }}</span>
							{% else %}
								{{ d.cost }}
							{% endif %}
						</td>
						<td>{{ d.payload_size }}</td>
						<td>{{ d.title|default('—') }}</td>
						<td>
							{% if d.active %}
								<span class="admin-badge admin-badge--ok">{{ 'admin.stadium-active-yes'|trans }}</span>
							{% else %}
								<span class="admin-badge">{{ 'admin.stadium-active-no'|trans }}</span>
							{% endif %}
						</td>
						<td>
							<form method="post" action="/admin/stadium.php?region={{ region }}">
								<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
								<input type="hidden" name="id" value="{{ d.id }}">
								<input type="hidden" name="action" value="{{ d.active ? 'deactivate' : 'activate' }}">
								<button class="admin-btn admin-btn--small" type="submit">
									{{ (d.active ? 'admin.stadium-deactivate' : 'admin.stadium-activate')|trans }}
								</button>
							</form>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
		{# A ordem da tabela é a ordem de inserção (mais recente primeiro), mas
		   o menu.cgb lista as ATIVAS na ordem em que foram inseridas -- não
		   na ordem em que aparecem aqui. Duas ou mais ativas com janelas que
		   se sobrepõem causam o vai-e-volta que a especificação descreve
		   (spec.md §5.3). Ativar mais de uma por região é responsabilidade
		   de quem ativa. #}
		<p class="admin-form__hint">{{ 'admin.stadium-order-note'|trans }}</p>
	{% endif %}
{% endblock %}
