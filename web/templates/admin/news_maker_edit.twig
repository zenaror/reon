{% extends "admin/layout.twig" %}

{% block admin_title %}{{ issue.name|default('admin.news-maker-new'|trans) }}{% endblock %}

{% block admin_actions %}
	<a class="btn btn-sm btn-outline-secondary" href="/admin/news_maker.php">{{ 'admin.news-maker-back'|trans }}</a>
{% endblock %}

{% block admin_head %}
	<script src="{{ asset('/js/news-lines.js') }}" defer></script>
	<script src="{{ asset('/js/news-date.js') }}" defer></script>
	<script src="{{ asset('/js/news-regions.js') }}" defer></script>
	<script src="{{ asset('/js/news-prizes.js') }}" defer></script>
{% endblock %}

{% block admin_body %}
	{# What each region's build did, shown before the form so the answer is
	   where the eye already is after pressing Publish. #}
	{% if results %}
		<section class="admin-section">
			<h2 class="admin-section__title">{{ 'admin.news-maker-result'|trans }}</h2>
			<div class="admin-scroll">
				<table class="admin-table">
					<tbody>
						{% for region, one in results %}
							<tr>
								<td>{{ region|upper }}</td>
								<td>
									{% if one[0] %}
										<span class="admin-pill admin-pill--up">ok</span> {{ one[1] }} bytes
									{% else %}
										<span class="admin-pill admin-pill--down">{{ 'admin.news-maker-failed-region'|trans }}</span>
										<code class="admin-form__hint">{{ one[1] }}</code>
									{% endif %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
			{% if log %}<pre class="admin-console mt-2">{{ log }}</pre>{% endif %}
		</section>
	{% endif %}

	{# The one permission this needs, said with the command. Deliberately a
	   single file rather than the directory: the shared config next to it
	   also carries the *vanilla* schedule, and the panel has no business
	   being able to write that. #}
	{% if not schedule_writable|default(false) %}
		<div class="admin-notice admin-notice--bad">
			<p class="mb-1"><strong>{{ 'admin.news-maker-schedule-locked'|trans }}</strong></p>
			<p class="mb-1">{{ 'admin.news-maker-schedule-why'|trans }}</p>
			<pre class="admin-console mb-0">echo '{"schedule":{}}' | sudo tee {{ schedule_path }} >/dev/null
sudo chown reon:reon {{ schedule_path }}</pre>
		</div>
	{% endif %}

	{# Publicada é imutável: a tela serve para conferir o que foi ao ar, não
	   para mexer. O campo `locked` vem de `NewsMakerUtil`, e o controlador
	   recusa gravar de novo mesmo que alguém poste à mão. #}
	{% if issue.locked|default(false) %}
		<div class="admin-notice admin-notice--bad">
			<p class="mb-1"><strong>{{ 'admin.news-maker-locked-title'|trans }}</strong></p>
			<p class="mb-0">{{ 'admin.news-maker-locked-why'|trans }}</p>
		</div>
	{% endif %}

	<form method="post" id="news-issue-form">
		<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
		<input type="hidden" name="slug" value="{{ issue.slug }}">
		{# Um fieldset desabilitado deixa tudo legível e nada editável, sem
		   precisar repetir a condição em cada campo. #}
		{% if issue.locked|default(false) %}<fieldset disabled style="border:0;padding:0;margin:0;min-width:0">{% endif %}

		<div class="admin-form">
			<label>
				{{ 'admin.news-maker-name'|trans }}
				<span class="admin-form__hint">{{ 'admin.news-maker-name-hint'|trans }}</span>
				<input type="text" name="name" required maxlength="60" value="{{ issue.name|default('') }}">
			</label>

		{# Mês e dia separados, e não um calendário: o ano não é escolha -- é
		   sempre o corrente, acrescentado ao gravar o calendário, e um
		   calendário completo obrigaria a escolher um ano que não significa
		   nada aqui. Fevereiro vai até 28 porque o dia 29 só existe em ano
		   bissexto, e a edição não sairia em três de cada quatro anos. #}
		{% set picked_month = issue.date|default('') ? issue.date|slice(0, 2) : '' %}
		{% set picked_day = issue.date|default('') ? issue.date|slice(3, 2) : '' %}
			<label data-news-date>
				{{ 'admin.news-maker-date'|trans }}
				<span class="admin-form__hint">{{ 'admin.news-maker-date-hint'|trans }}</span>
				<span class="admin-form__row">
					<select name="date_month" data-news-month
					        data-days="{{ days_in_month|join(',') }}">
						{% for n in 1..12 %}
							<option value="{{ n }}"{% if picked_month and picked_month|number_format == n %} selected{% endif %}>{{ ('admin.month-' ~ n)|trans }}</option>
						{% endfor %}
					</select>
					<select name="date_day" data-news-day data-picked="{{ picked_day|number_format ?: 1 }}">
						{% for n in 1..31 %}
							<option value="{{ n }}"{% if picked_day and picked_day|number_format == n %} selected{% endif %}>{{ n }}</option>
						{% endfor %}
					</select>
				</span>
			</label>

			<label>
				{{ 'admin.news-maker-template'|trans }}
				<span class="admin-form__hint">{{ 'admin.news-maker-template-hint'|trans }}</span>
				<select name="template">
					{% for template in templates %}
						<option value="{{ template }}"{% if template == issue.template|default('') %} selected{% endif %}>{{ template }}</option>
					{% endfor %}
				</select>
			</label>

			<label>
				{{ 'admin.news-maker-minigame'|trans }}
				<select name="minigame" data-news-minigame>
					{% for file, label in minigames %}
						<option value="{{ file }}"{% if file == issue.minigame|default('') %} selected{% endif %}>{{ label }}</option>
					{% endfor %}
				</select>
			</label>

			{# Os prêmios são do minijogo, não da edição: trocar o minijogo
			   troca a lista inteira, e a lista sai do código do próprio
			   minijogo -- o que aparece aqui é o que o jogo entrega.

			   Todos os conjuntos são desenhados e só o do minijogo escolhido
			   fica visível. Cada um é um `fieldset disabled`, e é o `disabled`
			   -- não o `hidden` -- que impede um conjunto escondido de mandar
			   os prêmios dele junto no POST. #}
			<div class="news-prizes" data-news-prizes>
				<span class="admin-form__label">{{ 'admin.news-maker-prizes'|trans }}</span>
				<span class="admin-form__hint">{{ 'admin.news-maker-prizes-hint'|trans }}</span>
				{% for file, slots in prizes_by_minigame %}
					<fieldset class="news-prizes__set" data-news-prize-set="{{ file }}"
					          {% if file != issue.minigame|default('') %}hidden disabled{% endif %}>
						{% if slots is empty %}
							<p class="admin-form__hint mb-0">{{ 'admin.news-maker-prize-none'|trans }}</p>
						{% endif %}
						{% for i, slot in slots %}
							<label>
								{{ 'admin.news-maker-prize'|trans({'%n%': i + 1}) }}{% if slot.quantity > 1 %} ×{{ slot.quantity }}{% endif %}
								{% if slot.fixed %}
									{# Prêmio que o minijogo monta sozinho (parâmetro de macro,
									   ou constante da tabela dele). Mostrado, e não escondido:
									   o jogador vai receber, e uma lista mais curta do que o
									   jogo entrega seria mentira. #}
									<span class="admin-form__hint">{{ 'admin.news-maker-prize-fixed'|trans }}</span>
									<input type="text" value="{{ slot.label }}" disabled>
								{% else %}
									<select name="prize[{{ i }}]">
										<option value="">— {{ 'admin.news-maker-prize-default'|trans({'%item%': slot.label}) }} —</option>
										{# `prize_items`, e não `items`: admin/layout.twig faz
										   `{% set items = [...] %}` para o próprio menu, e o bloco
										   do filho é renderizado no escopo do pai -- um `items`
										   aqui viraria a lista de menu, calado, com 9 opções
										   escritas "Array". #}
										{% for value, label in prize_items %}
											<option value="{{ value }}"{% if value == issue.prizes[i]|default('') %} selected{% endif %}>{{ label }}</option>
										{% endfor %}
									</select>
								{% endif %}
							</label>
						{% endfor %}
					</fieldset>
				{% endfor %}
			</div>

			{% for slot in 0..2 %}
				<label>
					{{ 'admin.news-maker-ranking'|trans({'%n%': slot + 1}) }}
					{% if slot == 0 %}<span class="admin-form__hint">{{ 'admin.news-maker-ranking-hint'|trans }}</span>{% endif %}
					<select name="ranking[{{ slot }}]">
						{# Sorteado ao salvar, não a cada compilação: a definição
						   guarda o que saiu, senão a mesma edição daria rankings
						   diferentes a cada build. #}
						<option value="__random__"{% if issue.rankings[slot]|default('') == '' %} selected{% endif %}>— {{ 'admin.news-maker-random'|trans }} —</option>
						{% for key, label in categories %}
							<option value="{{ key }}"{% if key == issue.rankings[slot]|default('') %} selected{% endif %}>{{ label }}</option>
						{% endfor %}
					</select>
				</label>
			{% endfor %}
		</div>

		<section class="admin-section">
			<h2 class="admin-section__title">{{ 'admin.news-maker-regions'|trans }}</h2>
			<p class="admin-form__hint">{{ 'admin.news-maker-regions-hint'|trans }}</p>
			{# Um destino por idioma, não por região. Inglês são três cartuchos
			   -- Estados Unidos, Europa e Austrália -- que consomem o mesmo
			   texto e compilam o mesmo binário, então pedir três cliques para
			   escrever o mesmo arquivo em três pastas seria ruído. Os outros
			   cinco ficam separados porque cada um carrega texto próprio. #}
			<div class="news-regions">
				{% for language, group in targets %}
					<label class="news-region" data-news-region="{{ language }}"
					       data-news-needs="{{ language }}"
					       data-news-why="{{ 'admin.news-maker-region-needs'|trans({'%lang%': ('admin.news-maker-lang-' ~ language)|trans}) }}">
						<input type="checkbox" name="regions[]" value="{{ language }}"
						       {% if group|first in issue.scheduled|default(issue.built|default([])) %}checked{% endif %}>
						<span>
							{{ ('admin.news-maker-lang-' ~ language)|trans }}
							{# Quais cartuchos recebem, dito onde não atrapalha:
							   é a resposta para "e o P e o U, foram?". #}
							{% if group|length > 1 %}
								<span class="admin-form__hint">{% for r in group %}{{ ('region.language.' ~ r)|trans }}{% if not loop.last %} · {% endif %}{% endfor %}</span>
							{% endif %}
						</span>
					</label>
				{% endfor %}
			</div>
		</section>
		<section class="admin-section">
			<h2 class="admin-section__title">{{ 'admin.news-maker-text'|trans }}</h2>
			<p class="admin-form__hint">{{ 'admin.news-maker-text-hint'|trans }}</p>
			<p class="admin-form__hint" data-news-empty hidden>{{ 'admin.news-maker-text-none'|trans }}</p>
			{% for key, letter in languages %}
				<div class="admin-form news-lang" data-news-lang="{{ key }}">
					<h3 style="margin:0 0 4px">{{ ('admin.news-maker-lang-' ~ key)|trans }}</h3>
					<label>
						{{ 'admin.news-maker-headline'|trans }}
						<span class="admin-form__hint">{{ 'admin.news-maker-headline-hint'|trans({'%n%': headline_max}) }}</span>
						<input type="text" name="headline[{{ key }}]"
						       maxlength="{{ headline_max }}"
						       value="{{ issue.headline[key]|default('') }}"
						       placeholder="POKéMON NEWS No.1">
					</label>
					<label>
						{{ 'admin.news-maker-message'|trans }}
						<span class="admin-form__hint">{{ 'admin.news-maker-message-hint'|trans({'%n%': message_max}) }}</span>
						<input type="text" name="message[{{ key }}]" maxlength="{{ message_max }}"
						       value="{{ issue.message[key]|default('') }}"
						       placeholder="{{ issue.headline[key]|default('') }}">
					</label>
					<label>
						{{ 'admin.news-maker-body'|trans }}
						<span class="admin-form__hint">{{ 'admin.news-maker-body-hint'|trans({'%n%': body_line_max}) }}</span>
						<textarea name="body[{{ key }}]" rows="6" spellcheck="false"
						          data-news-body data-max="{{ body_line_max }}">{{ issue.body[key]|default('') }}</textarea>
						<span class="admin-form__hint" data-news-count></span>
					</label>
				</div>
			{% endfor %}
		</section>


		{% if issue.locked|default(false) %}</fieldset>{% endif %}

		<div class="trainer-edit__actions">
			{% if not issue.locked|default(false) %}
				<button class="btn btn-outline-primary" type="submit" name="action" value="save"{% if missing is not empty %} disabled{% endif %}>{{ 'admin.news-maker-save'|trans }}</button>
				<button class="btn btn-primary" type="submit" name="action" value="publish"{% if missing is not empty %} disabled{% endif %}>{{ 'admin.news-maker-publish'|trans }}</button>
			{% endif %}
			{# Retirar e apagar dependem de a edição EXISTIR no disco, e não de
			   haver um slug: o slug sai do nome digitado, então um POST
			   recusado num formulário em branco fazia aparecer "apagar" para
			   uma edição que nunca foi gravada. #}
			{% if issue.exists|default(false) and issue.built|default([]) is not empty %}
				<button class="btn btn-outline-danger" type="submit" name="action" value="withdraw"
				        formnovalidate
				        onclick="return confirm('{{ 'admin.news-maker-withdraw-confirm'|trans|e('js') }}');">{{ 'admin.news-maker-withdraw'|trans }}</button>
			{% endif %}
			{% if issue.exists|default(false) %}
				<button class="btn btn-outline-danger" type="submit" name="action" value="delete"
				        formnovalidate
				        onclick="return confirm('{{ 'admin.news-maker-delete-confirm'|trans|e('js') }}');">{{ 'admin.trainer-delete'|trans }}</button>
			{% endif %}
		</div>
	</form>
{% endblock %}
