{# Portal sidebar: service status + the vine-threaded gem menu.
   Shared by every page that uses the home layout, so the adapter's
   hand-calibrated join with the cable lives in exactly one place.

   The gems are unlit until hovered; the one for the page being shown is
   lit with a glow and is not a link (still listed, so the menu reads the
   same everywhere). `current_path` comes from TemplateUtil. #}
		{% set path = current_path|default('/') %}
		{% set here = {
			'home':      path == '/' or path == '/index.php',
			'news':      path starts with '/news.php',
			'guide':     path starts with '/guide.php',
			'downloads': path starts with '/downloads.php',
			'mail':      path starts with '/user/mail.php',
			'pokemon':   path starts with '/pokemon/',
			'gbwars':    path starts with '/gbwars/',
			'mariokart': path starts with '/mariokart/',
		} %}
		<aside class="home-sidebar">
			<section class="reon-box reon-box--sidebar">
				<h2 class="reon-box__bar reon-box__bar--teal">{{'status'|trans}}</h2>
				<dl class="reon-status">
					<div>
						<dt>{{'service-web'|trans}}</dt>
						<dd class="reon-status__{{ services.web.status }}">{{ ('service-status-' ~ services.web.status)|trans }}</dd>
					</div>
					<div>
						<dt>{{'service-mail'|trans}}</dt>
						<dd class="reon-status__{{ services.mail.status }}">{{ ('service-status-' ~ services.mail.status)|trans }}</dd>
					</div>
					<div>
						<dt>{{'service-relay-policy'|trans}}</dt>
						<dd class="reon-status__{{ services.relay_policy.status }}">{{ ('service-status-' ~ services.relay_policy.status)|trans }}</dd>
					</div>
					<div>
						<dt>{{'service-mobile-relay'|trans}}</dt>
						<dd class="reon-status__{{ services.mobile_relay.status }}">
							{{ ('service-status-' ~ services.mobile_relay.status)|trans }}
							{%- if services.mobile_relay.status == 'up' and services.mobile_relay.detail is not null %} ({{ 'service-devices-connected'|trans({'%count%': services.mobile_relay.detail}) }}){% endif %}
						</dd>
					</div>
				</dl>
			</section>

			<nav class="reon-menu reon-menu--side">
				<svg class="reon-menu__vine" viewBox="0 0 40 300" preserveAspectRatio="none" aria-hidden="true">
					<defs>
						<linearGradient id="reonVineGrad" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" stop-color="#6fb7ec"/>
							<stop offset="1" stop-color="#1667b4"/>
						</linearGradient>
					</defs>
					<path d="M20 8 C 2 48, 38 88, 20 128 S 2 208, 20 248 S 34 292, 20 296"/>
				</svg>
				{# the vine plugs into a REON adapter that slips under the page border #}
				<img class="reon-menu__adapter" src="/images/mobile_adapter/REON_Blue_Adapter_Horizontal.svg" alt="" aria-hidden="true">

				{# One macro for every entry: an <a> normally, a <span> with
				   aria-current for the page we are on. #}
				{% macro item(active, href, gem, label, extra) %}
					{% if active %}
						<span class="reon-menu-item is-active" aria-current="page" style="--gem:{{ gem }}"><span class="reon-gem"></span><span class="label">{{ label }}{{ extra|default('')|raw }}</span></span>
					{% else %}
						<a class="reon-menu-item" href="{{ href }}" style="--gem:{{ gem }}"><span class="reon-gem"></span><span class="label">{{ label }}{{ extra|default('')|raw }}</span></a>
					{% endif %}
				{% endmacro %}
				{% import _self as menu %}

				{{ menu.item(here.home, '/index.php', 'var(--reon-blue)', 'home'|trans) }}
				{{ menu.item(here.news, '/news.php', 'var(--reon-purple)', 'news'|trans) }}
				{{ menu.item(here.guide, '/guide.php', 'var(--reon-pink)', 'guide'|trans) }}
				{{ menu.item(here.downloads, '/downloads.php', 'var(--reon-silver)', 'downloads'|trans) }}
				{% set mail_extra %}<span data-mail-badge data-mail-pulse="1">{% if mail_new > 0 %} <span class="mail-badge mail-badge--new mail-badge--pulse" title="{{ 'mail.new-arrived'|trans({'%count%': mail_new}) }}">{{ mail_new }}</span>{% endif %}</span>{% endset %}
				{{ menu.item(here.mail, '/user/mail.php', 'var(--reon-orange)', 'mail.title'|trans, mail_extra) }}
				{{ menu.item(here.pokemon, '/pokemon/', 'var(--reon-red)', 'pokemon-crystal'|trans) }}
				{{ menu.item(here.gbwars, '/gbwars/', 'var(--reon-green)', 'gameboy-wars'|trans) }}
				{{ menu.item(here.mariokart, '/mariokart/', 'var(--reon-yellow)', 'mario-kart.title'|trans) }}
				<a class="reon-menu-item" href="#" onclick="openGbcModal(); return false;" style="--gem:var(--reon-teal)"><span class="reon-gem"></span><span class="label">{{'mobile-home'|trans}}</span></a>
			</nav>
		</aside>
