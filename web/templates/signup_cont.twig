{% extends "main.twig" %}

{% block title %}{{'signup'|trans}}{% endblock %}
{% block content %}
	<div class="d-flex">
		{% if result != 0 and result != 1 %}
			<div class="card m-auto">
				<form method="post" accept-charset="utf-8" class="card-body">
					<fieldset>
						<legend>{{'auth.signup-to-reon'|trans}}</legend>
						<div class="mb-3">
							<label for="email" class="form-label">{{'email-addr'|trans}}</label>
							<input id="email" type="email" disabled class="form-control" value="{{ email|e }}">
						</div>
						<div class="mb-3">
							<label for="reonEmail" class="form-label">{{'auth.reon-username'|trans}}</label>
							{# minlength/maxlength/pattern mirror isDionEmailValidAndFree() exactly, so the
							   rules are enforced before a round-trip instead of only after one. #}
							<input id="reonEmail" type="text" name="reonEmail" required
							       minlength="3" maxlength="20" pattern="[a-z0-9]{3,20}"
							       autocapitalize="none" autocorrect="off" spellcheck="false"
							       class="form-control{% if result == 2 %}{{ " is-invalid" }}{% endif %}" value="{{ reon_email|e }}">
							<div class="form-text">{{'auth.reon-username-hint'|trans}}</div>
							<div id="reonNameStatus" class="form-text"></div>
							<div class="invalid-feedback">
								{{'auth.reon-username-invalid'|trans}}
							</div>
							<div class="alert alert-info mt-2 mb-0 py-2 px-3">
								<div class="small mb-1">{{'auth.reon-username-mail-note'|trans}}</div>
								<div class="small">
									<strong>{{'auth.reon-username-mail-internal'|trans}}:</strong>
									<code><span id="reonNameInternal">{{ reon_email|e }}</span>@{{ email_domain_dion|e }}</code>
								</div>
								<div class="small">
									<strong>{{'auth.reon-username-mail-external'|trans}}:</strong>
									<code><span id="reonNameExternal">{{ reon_email|e }}</span>@{{ email_domain|e }}</code>
									<span id="reonNameExternalAlt" class="d-none">
										{{'auth.reon-username-mail-or'|trans}}
										<code><span id="reonNameExternalShort"></span>@{{ email_domain|e }}</code>
									</span>
								</div>
								<div class="small text-muted mt-1">{{'auth.reon-username-mail-truncated'|trans}}</div>
							</div>
						</div>
						<div class="mb-3">
							<label for="password" class="form-label">{{'password'|trans}}</label>
							<input id="password" type="password" name="password" required class="form-control{% if result == 4 %}{{ " is-invalid" }}{% endif %}">
							<div class="invalid-feedback">
								{{'password-invalid'|trans}}
							</div>
						</div>
						<div class="mb-3">
							<label for="passwordConfirm" class="form-label">{{'confirm-password'|trans}}</label>
							<input id="passwordConfirm" type="password" name="passwordConfirm" required class="form-control{% if result == 3 %}{{ " is-invalid" }}{% endif %}">
							<div class="invalid-feedback">
								{{'passwords-dont-match'|trans}}
							</div>
						</div>
                        <div class="mb-3">
                            <label for="tradeRegions">{{ "account.trade-corner-region-allowlist"|trans }}</label>
                            
                            <small>
                            <details>
                                <summary>{{ "what-is-this"|trans }}</summary>
                                
                                <p>{{ "auth.region-explanation-para1"|trans }}</p>
                                <p>{{ "auth.region-explanation-para2"|trans }}</p>
                            </details>
                            </small>
                            
                            <select id="tradeRegions" name="tradeRegions" class="form-select">
                                <option value="e,f,d,s,i,p,u,j" {% if trade_regions == "e,f,d,s,i,p,u,j" %}selected{% endif %}>{{ "account.trade-option-1"|trans }}</option>
                                <option value="efdsipu,j" {% if trade_regions == "efdsipu,j" %}selected{% endif %}>{{ "account.trade-option-2"|trans }}</option>
                                <option value="efdsipuj" {% if trade_regions is not defined or trade_regions == "efdsipuj" %}selected{% endif %}>{{ "account.trade-option-3"|trans }}</option>
                            </select>
                        </div>
						<div class="mb-3">
							<label for="pokemonNewsCustomOptIn" class="form-label">{{ "account.pokemon-news-custom-opt-in"|trans }}</label>
							
							<small>
							<details>
								<summary>{{ "what-is-this"|trans }}</summary>
								<p>{{ "account.pokemon-news-custom-opt-in-blurb"|trans }}</p>
							</details>
							</small>
							
							<select id="pokemonNewsCustomOptIn" name="pokemonNewsCustomOptIn" class="form-select">
								<option value="0" {% if pokemon_news_custom_opt_in is not defined or pokemon_news_custom_opt_in == 0 %}selected{% endif %}>{{ "account.pokemon-news-custom-opt-in-off"|trans }}</option>
								<option value="1" {% if pokemon_news_custom_opt_in is defined and pokemon_news_custom_opt_in == 1 %}selected{% endif %}>{{ "account.pokemon-news-custom-opt-in-on"|trans }}</option>
							</select>
						</div>
						<button type="submit" class="btn btn-primary">{{'signup'|trans}}</button>
					</fieldset>
					<input type="hidden" name="id" value="{{ id|e }}" />
					<input type="hidden" name="key" value="{{ key|e }}" />
				</form>
			</div>
		{% elseif result == 0 %}
			<div class="alert alert-success m-auto">
				{{'auth.registration-complete'|trans}}
			</div>
		{% elseif result == 1 %}
			<div class="alert alert-danger m-auto">
				{{'link-invalid-expired'|trans}}
			</div>
		{% endif %}
	</div>
{% endblock %}

{% block body %}
<script>
(function () {
	var field = document.getElementById('reonEmail');
	var status = document.getElementById('reonNameStatus');
	var internal = document.getElementById('reonNameInternal');
	var external = document.getElementById('reonNameExternal');
	var altWrap = document.getElementById('reonNameExternalAlt');
	var altShort = document.getElementById('reonNameExternalShort');
	if (!field) return;

	var MIN = 3, MAX = 20;
	var signup = { id: {{ id|default(0)|json_encode|raw }}, key: {{ key|default('')|json_encode|raw }} };
	var TAKEN = {{ 'auth.reon-username-taken'|trans|json_encode|raw }};
	var FREE = {{ 'auth.reon-username-free'|trans|json_encode|raw }};

	function say(text, ok) {
		if (!status) return;
		status.textContent = text;
		status.className = 'form-text ' + (ok ? 'text-success' : 'text-danger');
	}

	// The in-game address is 8 characters and can differ from a plain truncation
	// when that prefix is already taken, so it's only ever shown using the value
	// the server derived -- never guessed here.
	function showAddresses(dionLocal) {
		var name = field.value;
		if (external) external.textContent = name;
		if (internal) internal.textContent = dionLocal || name.slice(0, 8);
		if (altWrap && altShort) {
			if (dionLocal && dionLocal !== name) {
				altShort.textContent = dionLocal;
				altWrap.classList.remove('d-none');
			} else {
				altWrap.classList.add('d-none');
			}
		}
	}

	var timer = null;
	function check() {
		var name = field.value;
		if (name.length < MIN || name.length > MAX || !/^[a-z0-9]+$/.test(name)) {
			say('', true);
			showAddresses('');
			return;
		}
		var url = '/check_username.php?id=' + encodeURIComponent(signup.id) +
		          '&key=' + encodeURIComponent(signup.key) +
		          '&name=' + encodeURIComponent(name);
		fetch(url)
			.then(function (r) { return r.json(); })
			.then(function (j) {
				if (field.value !== name) return;   // typed on while in flight
				if (j.available) {
					say(FREE, true);
					field.setCustomValidity('');
					showAddresses(j.dion_local);
				} else {
					say(TAKEN, false);
					field.setCustomValidity(TAKEN);
					showAddresses('');
				}
			})
			.catch(function () { /* stay quiet; submit still validates */ });
	}

	// Hard stop at the limit rather than flagging an over-long value as an
	// error: there is nothing useful the person could do with the extra
	// character. maxlength already covers typing; this also catches paste,
	// autofill and IME input, which it doesn't -- and folds case and strips
	// disallowed characters instead of leaving them to be rejected later.
	function clamp() {
		var cleaned = field.value.toLowerCase().replace(/[^a-z0-9]/g, '');
		if (cleaned.length > MAX) cleaned = cleaned.slice(0, MAX);
		if (cleaned !== field.value) {
			var at = field.selectionStart;
			field.value = cleaned;
			try { field.setSelectionRange(Math.min(at, cleaned.length), Math.min(at, cleaned.length)); } catch (e) {}
		}
	}

	field.addEventListener('input', function () {
		clamp();
		showAddresses('');
		// Red is reserved for "this name is taken"; a half-typed name is not an
		// error, it's just unfinished.
		field.setCustomValidity('');
		clearTimeout(timer);
		timer = setTimeout(check, 350);
	});

	// Also check the pre-filled suggestion, so a name taken between generating
	// this page and reading it is flagged straight away.
	check();
})();
</script>
{% endblock %}
