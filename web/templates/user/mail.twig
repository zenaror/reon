{% extends "main.twig" %}
{% set nav_item = "mail" %}
{# "home" keeps the portal background; the sidebar wrapper is deliberately
   absent so the mailbox runs the full width, like the per-game pages. #}
{% set body_class = "home home-v2 reon-mail" %}

{% block title %}{{'mail.title'|trans}}{% endblock %}

{% block head %}
	<link href="{{ asset('/css/home.css') }}" rel="stylesheet">
	<link href="{{ asset('/css/home-v2.css') }}" rel="stylesheet">
{% endblock %}

{% block content %}
	<div class="reon-pickup">{{'mail.title'|trans}}<span class="bar"></span></div>

	{# Folder tabs, styled after the Mobile Trainer's menu buttons: the
	   selected one is the pale plate, the rest are the dark plates. #}
	{# A tab badge means "this wants you", not "this holds things": only unread
	   mail qualifies. Plain totals live on the panel bar of the folder you are
	   actually looking at, where they describe what is on screen. #}
	<nav class="mt-tabs">
		<a class="mt-tab{{ folder == 'inbox' ? ' mt-tab--on' : '' }}" href="/user/mail.php">
			{{'mail.inbox'|trans}}{% if mail_new > 0 %} <span class="mt-tab__count mt-tab__count--new" title="{{ 'mail.new-arrived'|trans({'%count%': mail_new}) }}">{{ mail_new }}</span>{% endif %}
		</a>
		<a class="mt-tab{{ folder == 'sent' ? ' mt-tab--on' : '' }}" href="/user/mail.php?folder=sent">{{'mail.sent'|trans}}</a>
		<a class="mt-tab{{ folder == 'trash' ? ' mt-tab--on' : '' }}" href="/user/mail.php?folder=trash">{{'mail.trash'|trans}}</a>

		{# Only on the list: re-requests the folder being shown. Mail arrives
		   over SMTP whenever it arrives, so the page has no way to know on its
		   own that something landed. #}
		{% if messages is not null %}
			<span class="mt-tabs__actions">
				<a class="mt-btn" href="/user/mail.php?compose=1">{{'mail.compose'|trans}}</a>
				<a class="mt-btn" href="/user/mail.php{{ folder == 'trash' ? '?folder=trash' : '' }}" title="{{'mail.refresh'|trans}}">
					<span aria-hidden="true">&#8635;</span> {{'mail.refresh-short'|trans}}<span class="visually-hidden"> {{'mail.refresh'|trans}}</span>
				</a>
			</span>
		{% endif %}
	</nav>

	{% if compose is not null %}
		<section class="mt-panel">
			<h2 class="mt-panel__bar">{{'mail.compose'|trans}}</h2>

			{% if compose_error %}
				<p class="mt-error">
					{% if compose_error == 'empty' %}{{'mail.err-empty'|trans}}
					{% elseif compose_error == 'bad-address' %}{{'mail.err-bad-address'|trans}}
					{% elseif compose_error == 'rate-limited' %}{{'mail.err-rate-limited'|trans}}
					{% elseif compose_error == 'too-many-lines' %}{{'mail.err-too-many-lines'|trans({'%lines%': body_max_lines})}}
					{% elseif compose_error == 'too-many-chars' %}{{'mail.err-too-many-chars'|trans({'%chars%': body_max_chars})}}
					{% elseif compose_error == 'relay-failed' %}{{'mail.err-relay-failed'|trans}}
					{% else %}{{'mail.err-failed'|trans}}{% endif %}
				</p>
			{% endif %}

			<form class="mt-compose" method="post" action="/user/mail.php">
				<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
				<input type="hidden" name="action" value="send">
				<label>
					<span>{{'mail.to'|trans}}</span>
					<input type="text" name="to" value="{{ compose.to }}" autocomplete="off" required>
				</label>
				<label>
					<span>{{'mail.subject'|trans}}</span>
					<input type="text" name="subject" value="{{ compose.subject }}" autocomplete="off">
				</label>
				<label>
					<span>{{'mail.body'|trans}}</span>
					<textarea name="body" id="mt-body" rows="9" required
						data-max-lines="{{ body_max_lines }}" data-max-chars="{{ body_max_chars }}">{{ compose.body }}</textarea>
				</label>
				{# The counter mirrors the server's rule exactly, so nobody
				   writes a whole message only to have it refused on submit. #}
				<p class="mt-count" id="mt-body-count" aria-live="polite"></p>
				<p class="mt-note">{{'mail.compose-note'|trans}}</p>
				<p class="mt-note">{{'mail.size-note'|trans({'%lines%': body_max_lines, '%chars%': body_max_chars})}}</p>
				<div class="mt-statusbar mt-statusbar--inline">
					<span class="mt-statusbar__hint">{{'mail.hint-compose'|trans}}</span>
					<span class="mt-statusbar__acts">
						<a class="mt-btn" href="/user/mail.php">{{'mail.back'|trans}}</a>
						<button class="mt-btn" type="submit">{{'mail.send'|trans}}</button>
					</span>
				</div>
			</form>

			<script>
			(function () {
				var box = document.getElementById("mt-body");
				var out = document.getElementById("mt-body-count");
				if (!box || !out) return;

				var maxLines = parseInt(box.dataset.maxLines, 10);
				var maxChars = parseInt(box.dataset.maxChars, 10);
				var template = {{ 'mail.size-count'|trans|json_encode|raw }};

				function update() {
					// Same rule as MailUtil::checkBodyFits: line breaks are not
					// counted against the character budget.
					var text = box.value.replace(/\r\n|\r/g, "\n");
					var lines = text.split("\n").length;
					var chars = Array.from(text.replace(/\n/g, "")).length;

					out.textContent = template
						.replace("%lines%", lines).replace("%maxlines%", maxLines)
						.replace("%chars%", chars).replace("%maxchars%", maxChars);
					out.classList.toggle("mt-count--over", lines > maxLines || chars > maxChars);
				}

				box.addEventListener("input", update);
				update();
			})();
			</script>
		</section>

	{% elseif messages is not null %}
		{% if sent|default(false) %}
			<p class="mt-sent">{{'mail.sent-ok'|trans}}</p>
		{% endif %}

		{# Filled in by the background check below. A banner rather than a
		   reload: reloading would discard a half-written message, and would
		   also run markInboxSeen every minute, clearing the "new" marker for
		   mail nobody had looked at. #}
		<p class="mt-newmail" id="mt-newmail" hidden>
			<span id="mt-newmail-text"></span>
			<a class="mt-btn" href="{{ folder == 'trash' ? '/user/mail.php?folder=trash' : '/user/mail.php' }}">{{'mail.show-new'|trans}}</a>
		</p>
		{# Sent used to fall through to "Inbox" here, so the panel disagreed with
		   the tab you had just clicked. #}
		{% set folder_total = folder == 'sent' ? sent_count : (folder == 'trash' ? trash_count : mail_count) %}
		<section class="mt-panel">
			<h2 class="mt-panel__bar">
				{%- if folder == 'trash' %}{{'mail.trash'|trans}}
				{%- elseif folder == 'sent' %}{{'mail.sent'|trans}}
				{%- else %}{{'mail.inbox'|trans}}{% endif %}
				{%- if folder_total > 0 %} <span class="mt-panel__count">{{ folder_total }}</span>{% endif %}
			</h2>

			{% if messages is empty %}
				<p class="mt-empty">{% if folder == 'trash' %}{{'mail.trash-empty'|trans}}{% elseif folder == 'sent' %}{{'mail.sent-empty'|trans}}{% else %}{{'mail.empty'|trans}}{% endif %}</p>
			{% else %}
				{# One form around the whole list: the checkboxes post as ids[],
				   and the buttons in the bar below act on the selection. Per-row
				   forms aren't possible here -- nesting forms is invalid.

				   Sent gets no form at all. There is nothing to do to a sent
				   copy -- no trash, no restore -- so a checkbox there offered a
				   selection that no button could act on. #}
				{% set pickable = folder != 'sent' %}
				{% if pickable %}
				<form method="post" action="/user/mail.php" id="mt-listform">
					<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
					<div class="mt-selectall">
						<label>
							<input type="checkbox" id="mt-all">
							{{'mail.select-all'|trans}}
						</label>
						<span class="mt-selectall__count" id="mt-count" aria-live="polite"></span>
					</div>
				{% endif %}

					<ol class="mt-list{{ pickable ? '' : ' mt-list--nopick' }}">
						{% for m in messages %}
							<li class="mt-list__row{{ folder != 'trash' and m.unread ? ' is-unread' : '' }}">
								{% if pickable %}
									<label class="mt-list__pick">
										<input type="checkbox" class="mt-pick" name="ids[]" value="{{ m.id }}">
										<span class="visually-hidden">{{ m.subject ?: '(' ~ 'mail.no-subject'|trans ~ ')' }}</span>
									</label>
								{% endif %}
								{# The numbered gutter is the Mobile Trainer's mailbox slot number. #}
								<span class="mt-list__num">{{ loop.index }}</span>
								<span class="mt-list__main">
									{# The game gets a 10-character subject; the list has room for
									   far more, and the whole thing is on the message page. #}
									{% set subj = m.subject ?: '(' ~ 'mail.no-subject'|trans ~ ')' %}
									<a class="mt-list__subject" href="/user/mail.php?id={{ m.id }}{% if folder == 'sent' %}&amp;folder=sent{% endif %}" title="{{ subj }}">{{ subj|length > 60 ? subj|slice(0, 57) ~ '...' : subj }}</a>
									<span class="mt-list__meta">
										{% if folder == 'sent' %}{{'mail.to'|trans}}: {% endif %}{{ m.from_name ?: m.sender }} &middot; {{ m.timestamp|date("Y.m.d H:i") }}
									{%- if folder == 'sent' %} &middot; {{ m.origin == 'game' ? 'mail.via-game'|trans : 'mail.via-web'|trans }}{% endif %}
										{% if folder == 'trash' %}
											&middot; {{ m.deleted_by == 'game' ? 'mail.by-game'|trans : 'mail.by-web'|trans }}
											{# Whether the game took a copy before deleting is the one thing
											   that distinguishes a normal sync from a discard-unread. #}
											&middot; {{ m.retrieved ? 'mail.was-downloaded'|trans : 'mail.never-downloaded'|trans }}
										{% endif %}
									</span>
								</span>
							</li>
						{% endfor %}
					</ol>

					{% if pickable %}
					<div class="mt-statusbar mt-statusbar--inline">
						<span class="mt-statusbar__hint">{{ folder == 'trash' ? 'mail.hint-trash'|trans : 'mail.hint-list'|trans }}</span>
						<span class="mt-statusbar__acts">
							{% if folder == 'trash' %}
								<button class="mt-btn mt-needs-pick" type="submit" name="action" value="restore" disabled>{{'mail.restore-selected'|trans}}</button>
								<button class="mt-btn mt-btn--danger mt-needs-pick" type="submit" name="action" value="delete" disabled
									data-confirm="{{'mail.confirm-delete'|trans}}">{{'mail.delete-selected-forever'|trans}}</button>
							{% else %}
								<button class="mt-btn mt-needs-pick" type="submit" name="action" value="trash" disabled>{{'mail.delete-selected'|trans}}</button>
							{% endif %}
						</span>
					</div>
				</form>
					{% endif %}
			{% endif %}
		</section>

		{% if folder == 'trash' %}
			<p class="mt-note">{{'mail.trash-note'|trans({'%days%': retention_days})}}</p>
		{% endif %}

		<script>
		(function () {
			var banner = document.getElementById("mt-newmail");
			var text = document.getElementById("mt-newmail-text");
			if (!banner || !text) return;

			var EVERY = 60000;
			var template = {{ 'mail.new-arrived'|trans|json_encode|raw }};
			// What the page was rendered with. Anything beyond this is news.
			var known = {{ mail_count|default(0) }};
			var timer = null;

			function check() {
				fetch("/user/mail_status.php", { credentials: "same-origin" })
					.then(function (r) { return r.ok ? r.json() : null; })
					.then(function (data) {
						if (!data) return;
						var extra = data.count - known;
						if (extra > 0) {
							text.textContent = template.replace("%count%", extra);
							banner.hidden = false;
						}
					})
					// A failed check is not worth telling anyone about; the
					// next one is a minute away.
					.catch(function () {});
			}

			function start() { if (!timer) timer = setInterval(check, EVERY); }
			function stop() { if (timer) { clearInterval(timer); timer = null; } }

			// Nothing is polled while the tab is in the background: a mailbox
			// left open in a tab for a day should not spend the day asking.
			document.addEventListener("visibilitychange", function () {
				if (document.hidden) { stop(); } else { check(); start(); }
			});

			if (!document.hidden) start();
		})();
		</script>

		<script>
		(function () {
			var form = document.getElementById("mt-listform");
			if (!form) return;

			var all = document.getElementById("mt-all");
			var count = document.getElementById("mt-count");
			var picks = [].slice.call(form.querySelectorAll(".mt-pick"));
			var acts = [].slice.call(form.querySelectorAll(".mt-needs-pick"));
			var template = {{ 'mail.n-selected'|trans|json_encode|raw }};

			function sync() {
				var n = picks.filter(function (p) { return p.checked; }).length;
				// The actions are disabled with nothing picked, so the buttons
				// can never post an empty selection.
				acts.forEach(function (b) { b.disabled = n === 0; });
				if (count) count.textContent = n === 0 ? "" : template.replace("%count%", n);
				if (all) {
					all.checked = n > 0 && n === picks.length;
					all.indeterminate = n > 0 && n < picks.length;
				}
			}

			if (all) {
				all.addEventListener("change", function () {
					picks.forEach(function (p) { p.checked = all.checked; });
					sync();
				});
			}
			picks.forEach(function (p) { p.addEventListener("change", sync); });

			// Tracked on click rather than read from e.submitter alone: where
			// submitter is unsupported it is undefined, and the destructive
			// button would then submit with no confirmation at all.
			var clicked = null;
			acts.forEach(function (b) {
				b.addEventListener("click", function () { clicked = b; });
			});

			form.addEventListener("submit", function (e) {
				var btn = e.submitter || clicked;
				clicked = null;
				if (btn && btn.dataset.confirm && !confirm(btn.dataset.confirm)) {
					e.preventDefault();
				}
			});

			sync();
		})();
		</script>

	{% elseif message is null %}
		<section class="mt-panel">
			<h2 class="mt-panel__bar">{{'mail.message'|trans}}</h2>
			<p class="mt-empty">{{'mail.not-found'|trans}}</p>
		</section>
		<p><a class="reon-chrome-btn" href="/user/mail.php">{{'mail.back'|trans}}</a></p>

	{% else %}
		<section class="mt-panel">
			<h2 class="mt-panel__bar">{{ message.subject ?: '(' ~ 'mail.no-subject'|trans ~ ')' }}</h2>

			{# Label/value table lifted from the Mobile Trainer's message screen:
			   mint label cell on the left, white value cell on the right. #}
			<dl class="mt-fields">
				<div><dt>{{'mail.from'|trans}}</dt><dd>{{ message.from_name ? message.from_name ~ ' <' ~ message.sender ~ '>' : message.sender }}</dd></div>
				<div><dt>{{'mail.date'|trans}}</dt><dd>{{ message.timestamp|date("Y.m.d H:i") }}</dd></div>
				{% if message.game %}
					<div><dt>{{'mail.game'|trans}}</dt><dd>{{ message.game }}</dd></div>
				{% endif %}
			</dl>

			{# Decoded from ISO-2022-JP by MailUtil; escaped by Twig, then
			   rendered pre-wrapped because game mail is fixed-line text. #}
			<pre class="mt-body">{{ message.body }}</pre>
		</section>

		{# The black hint bar is the Mobile Trainer's bottom status line, and it
		   names the action the buttons beside it perform. #}
		<div class="mt-statusbar">
			<span class="mt-statusbar__hint">{{ message.deleted_at ? 'mail.hint-trash'|trans : 'mail.hint-read'|trans }}</span>
			<span class="mt-statusbar__acts">
				<a class="mt-btn" href="{{ message.deleted_at ? '/user/mail.php?folder=trash' : '/user/mail.php' }}">{{'mail.back'|trans}}</a>
				<a class="mt-btn" href="/user/mail.php?compose=1&amp;reply={{ message.id }}">{{'mail.reply'|trans}}</a>
				{% if message.deleted_at %}
					<form method="post" action="/user/mail.php">
						<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
						<input type="hidden" name="id" value="{{ message.id }}">
						<input type="hidden" name="action" value="restore">
						<button class="mt-btn" type="submit">{{'mail.restore'|trans}}</button>
					</form>
					<form method="post" action="/user/mail.php" onsubmit="return confirm('{{'mail.confirm-delete'|trans|e('js')}}');">
						<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
						<input type="hidden" name="id" value="{{ message.id }}">
						<input type="hidden" name="action" value="delete">
						<button class="mt-btn mt-btn--danger" type="submit">{{'mail.delete-forever'|trans}}</button>
					</form>
				{% else %}
					<form method="post" action="/user/mail.php">
						<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
						<input type="hidden" name="id" value="{{ message.id }}">
						<input type="hidden" name="action" value="trash">
						<button class="mt-btn" type="submit">{{'mail.delete'|trans}}</button>
					</form>
				{% endif %}
			</span>
		</div>
	{% endif %}
{% endblock %}
