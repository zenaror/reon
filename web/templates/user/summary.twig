{% extends "main.twig" %}

{% block title %}{{'your-account'|trans}}{% endblock %}

{% block head %}
	<script src="/js/user/summary.js"></script>
	<style>
		/* A moldura. Mesma linguagem do resto do site (.reon-panel): borda
		   dura, canto reto, sombra deslocada sem desfoque. O fundo é o campo
		   cinza claro e não o branco do cartão, para a caixa ler como um
		   mostrador em vez de um retângulo perdido no meio do formulário. */
		.adapter-art {
			background: var(--reon-paper);
			border: 2px solid var(--reon-line);
			border-radius: var(--reon-radius);
			box-shadow: var(--reon-shadow-hard);
			padding: 1rem;
			margin: 1.25rem auto 1.5rem;
			max-width: 420px;
		}
		/* A arte nasce em pé (281x842) e o adaptador se lê deitado. Girar não
		   muda a caixa que o elemento ocupa, então o palco é declarado já
		   deitado e a imagem é medida contra ele: largura 281/842 do palco,
		   que depois do giro vira a altura. As duas proporções são a mesma,
		   então não sobra borda nem corta desenho. */
		.adapter-art__stage {
			position: relative;
			width: 100%;
			aspect-ratio: 842 / 281;
		}
		.adapter-art__stage img {
			position: absolute;
			top: 50%;
			left: 50%;
			width: 33.3729%;
			height: auto;
			transform: translate(-50%, -50%) rotate(-90deg);
		}
		/* A sombra dura é 3px para a direita e para baixo: sem isto ela sai
		   da caixa do cartão em telas estreitas. */
		@media (max-width: 575.98px) {
			.adapter-art { margin-right: 3px; }
		}
	</style>
	<noscript>
		<style>
			.js-only {
				display: none !important;
			}
		</style>
	</noscript>
{% endblock %}

{% block content %}
	<h1>{{'account.your-reon-account'|trans}}</h1>
	{# Two columns that each stack their own cards, instead of three rows
	   pairing a left card with a right one. The rows looked right only
	   while the pairs happened to match in height: the identity card had
	   no partner, so the settings card waited for the next row and left a
	   hole under Stats, and nothing separated one row from the next, so
	   the identity and DION cards touched. Stacking gives every card the
	   same gap and lets the right column follow its own content. #}
	<div class="row">
		<div class="col-lg-6">
			<div class="card mb-4">
				<div class="card-header">
					{{'account.account-details'|trans}}
				</div>
				<div class="card-body">
					<div class="mb-3">
						<label for="email" class="form-label">{{'email-addr'|trans}}</label>
						<input id="email" type="text" readonly class="form-control" value="{{ email|e }}">
					</div>
					<hr>
					<a href="change_email.php" class="btn btn-primary">{{'account.change-email'|trans}}</a>
					<a href="change_password.php" class="btn btn-primary">{{'account.change-password'|trans}}</a>
					{# O download mora aqui quando não há cartão de adaptador. Com a
					   escolha liberada ele muda de casa, para ficar junto do que
					   decide o conteúdo do arquivo -- escolher a cor e baixar a bin
					   viram um gesto só, em vez de dois cartões distantes. #}
					{% if not adapter_choice_allowed %}
						<a href="adapter_config.php" class="btn btn-primary" download="mobile_config.bin">{{'account.download-config-data'|trans}}</a>
					{% endif %}
				</div>
			</div>
			<div class="card mb-4">
				<div class="card-header">
					{{'account.reon-identity'|trans}}
				</div>
				<div class="card-body">
					<div class="mb-3">
						<label for="username" class="form-label">{{'auth.reon-username'|trans}}</label>
						<input id="username" type="text" readonly class="form-control" value="{{ username|e }}">
					</div>
					<div class="mb-3">
						<label for="externalEmail" class="form-label">{{'account.external-email'|trans}}</label>
						<input id="externalEmail" type="text" readonly class="form-control" value="{{ external_email|e }}">
						{% if external_email_short != external_email %}
							<div class="form-text">
								{{'account.external-email-alias'|trans}}
								<code>{{ external_email_short|e }}</code>
							</div>
						{% endif %}
					</div>
				</div>
			</div>
			<div class="card mb-4">
				<div class="card-header">
					{{'account.dion-account-details'|trans}}
				</div>
				<div class="card-body">
					<div class="mb-3">
						<label for="dionPppId" class="form-label">{{'account.dion-id'|trans}}</label>
						<input id="dionPppId" type="text" readonly class="form-control" value="{{ dion_ppp_id|e }}">
					</div>
					<div class="mb-3">
						<label for="dionEmail" class="form-label">{{'email-addr'|trans}}</label>
						<input id="dionEmail" type="text" readonly class="form-control" value="{{ dion_email|e }}">
					</div>
					<div class="mb-3">
						<label for="dionPassword" class="form-label js-only">{{'account.log-in-password'|trans}}</label>
						<div class="input-group js-only">
							<input id="dionPassword" type="text" readonly class="form-control" value="&lt;hidden&gt;" data-password="{{ log_in_password|e }}" aria-describedby="dionPasswordRevealButton">
							<button id="dionPasswordRevealButton" type="button" class="btn btn-outline-primary">{{'reveal'|trans}}</button>
						</div>
						<noscript>
							<label for="dionPasswordNoJs" class="form-label">{{'account.log-in-password'|trans}}</label>
							<input id="dionPasswordNoJs" type="text" readonly class="form-control" value="{{ log_in_password|e }}">
						</noscript>
					</div>
					{% if relay_number %}
					<div class="mb-3">
						<label for="relayNumber" class="form-label">{{'account.relay-number'|trans}}</label>
						<input id="relayNumber" type="text" readonly class="form-control" value="{{ relay_number|e }}">
					</div>
					<div class="mb-3">
						<label for="relayToken" class="form-label js-only">{{'account.relay-token'|trans}}</label>
						<div class="input-group js-only">
							<input id="relayToken" type="text" readonly class="form-control" value="&lt;hidden&gt;" data-token="{{ relay_token|e }}" aria-describedby="relayTokenRevealButton">
							<button id="relayTokenRevealButton" type="button" class="btn btn-outline-primary">{{'reveal'|trans}}</button>
						</div>
						<noscript>
							<label for="relayTokenNoJs" class="form-label">{{'account.relay-token'|trans}}</label>
							<input id="relayTokenNoJs" type="text" readonly class="form-control" value="{{ relay_token|e }}">
						</noscript>
					</div>
					{% endif %}
					<hr>
					<button type="button" class="btn btn-primary js-only" data-bs-toggle="modal" data-bs-target="#confirmPasswordRerollModal">{{'account.reroll-log-in-password'|trans}}</button>
					<noscript>
						<a href="reroll_password.php" class="btn btn-primary">{{'account.reroll-log-in-password'|trans}}</a>
					</noscript>
					<a href="devices.php" class="btn btn-primary">{{'devices.title'|trans}}</a>
				</div>
			</div>
		</div>
		<div class="col-lg-6">
			<div class="card mb-4">
				<div class="card-header">
					{{'account.stats'|trans}}
				</div>
				<div class="card-body">
					<div class="mb-3">
						<label for="inboxSize" class="form-label">{{'account.emails-in-inbox'|trans}}</label>
						<input id="inboxSize" type="text" readonly class="form-control-plaintext" value="{{ inbox_size }}">
					</div>
					<div class="mb-3">
						<label for="moneySpent" class="form-label">{{'account.money-spent'|trans}}</label>
						<input id="moneySpent" type="text" readonly class="form-control-plaintext" value="{{ money_spent }}">
					</div>
				</div>
			</div>
			{# Só existe quando o painel libera. O formulário é separado do
			   de Pokémon Crystal de propósito: são assuntos diferentes, e
			   juntá-los faria um salvar mexer no outro. #}
			{% if adapter_choice_allowed %}
			<div class="card mb-4">
				<div class="card-header">{{ "account.adapter-settings"|trans }}</div>
				<div class="card-body">
					<form method="post">
						<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
						<div class="mb-3">
							<label for="adapterDevice" class="form-label">{{ "account.adapter-color"|trans }}</label>
							<small><p>{{ "account.adapter-blurb"|trans }}</p></small>
							{# O desenho do adaptador escolhido. As artes são retratos
							   (281x842) e o adaptador se lê deitado, então giram -90°,
							   o que dá exatamente o 842x281 da arte horizontal que já
							   existe. Decorativo: quem nomeia a cor é o menu abaixo,
							   e repetir o nome aqui faria o leitor de tela dizer duas
							   vezes a mesma coisa.

							   Os quatro ficam no HTML e só um aparece, para a troca
							   ser instantânea e não piscar enquanto baixa. Sem
							   JavaScript, aparece o que está salvo -- que é o certo,
							   já que sem script o menu também não muda nada. #}
							<div class="adapter-art" aria-hidden="true">
								<div class="adapter-art__stage">
									{% for code, nome in adapter_models %}
										<img src="{{ asset('/images/mobile_adapter/REON_Adapter_' ~ nome ~ '.svg') }}"
											alt="" data-adapter="{{ code }}"
											{% if adapter_device != code ~ '' %}hidden{% endif %}>
									{% endfor %}
								</div>
							</div>
							<select id="adapterDevice" name="adapterDevice" class="form-select">
								{% for code, nome in adapter_models %}
									<option value="{{ code }}"{% if adapter_device == code ~ '' %} selected{% endif %}>{{ ("account.adapter-color-" ~ code)|trans }}</option>
								{% endfor %}
							</select>
						</div>
						<div class="mb-3">
							<div class="form-check">
								<input class="form-check-input" type="checkbox" id="adapterUnmetered" name="adapterUnmetered" value="1"{% if adapter_unmetered %} checked{% endif %}>
								<label class="form-check-label" for="adapterUnmetered">{{ "account.adapter-unmetered"|trans }}</label>
							</div>
							<small>
							<details>
								<summary>{{ "what-is-this"|trans }}</summary>
								<p>{{ "account.adapter-unmetered-explanation"|trans }}</p>
							</details>
							</small>
						</div>
						{% if ("adapterValue" in errors) %}
							<small><p>{{ "account.adapter-invalid"|trans }}</p></small>
						{% endif %}
						{% if adapter_is_default %}
							<small><p>{{ "account.adapter-following-default"|trans }}</p></small>
						{% endif %}
						<small><p>{{ "account.adapter-download-note"|trans }}</p></small>
						{# Os dois lado a lado, e o de baixar é um SUBMIT, não um
						   link. Como link ele baixaria o que está gravado, e quem
						   acabou de trocar a cor sem salvar receberia uma bin que
						   não corresponde à tela -- justamente no gesto em que as
						   duas coisas parecem uma só. Enviando o formulário, o
						   servidor grava e só então entrega o arquivo. #}
						<div class="d-flex flex-wrap gap-2">
							<button type="submit" class="btn btn-primary">{{ "account.update-settings"|trans }}</button>
							<button type="submit" name="downloadAfterSave" value="1" class="btn btn-primary">{{'account.download-config-data'|trans}}</button>
						</div>
					</form>
				</div>
			</div>
			{% endif %}
			<div class="card mb-4">
				<div class="card-header">{{ "account.pokemon-crystal-settings"|trans }}</div>
				<div class="card-body">
                    <form method="post">
                    	<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                        <div class="mb-3">
                            <label for="tradeRegions">{{ "account.trade-corner-region-allowlist"|trans }}</label>
                            <small><p>{{ "account.trade-region-allowlist-blurb"|trans }}</p></small>
                            <select id="tradeRegions" name="tradeRegions">
                                <option value="e,f,d,s,i,p,u,j"{%
                                    if (trade_region_allowlist == "e,f,d,s,i,p,u,j")
                                %} selected{% endif %}>{{ "account.trade-option-1"|trans }}</option>
                                <option value="efdsipu,j"{%
                                    if (trade_region_allowlist == "efdsipu,j")
                                %} selected{% endif %}>{{ "account.trade-option-2"|trans }}</option>
                                <option value="efdsipuj"{%
                                    if (trade_region_allowlist == "efdsipuj")
                                %} selected{% endif %}>{{ "account.trade-option-3"|trans }}</option>
                            </select>
                            {% if ("regionValue" in errors) %}
                            <small><p>{{ "invalid-trade-setting"|trans }}</p></small>
                            {% endif %}
                        </div>
                        
                        <div class="mb-3">
                            <label for="pokemonNewsCustomOptIn">{{ "account.pokemon-news-custom-opt-in"|trans }}</label>
                            <small><p>{{ "account.pokemon-news-custom-opt-in-blurb"|trans }}</p></small>
                            <select id="pokemonNewsCustomOptIn" name="pokemonNewsCustomOptIn">
                                <option value="0"{% if pokemon_news_custom_opt_in == 0 %} selected{% endif %}>{{ "account.pokemon-news-custom-opt-in-off"|trans }}</option>
                                <option value="1"{% if pokemon_news_custom_opt_in == 1 %} selected{% endif %}>{{ "account.pokemon-news-custom-opt-in-on"|trans }}</option>
                            </select>
                            {% if ("pokemonNewsValue" in errors) %}
                            <small><p>{{ "invalid-pokemon-news-setting"|trans }}</p></small>
                            {% endif %}
                        </div>
                        
                        <div class="mb-3">
                            <label for="timeZone">{{ "account.time-zone"|trans }}</label>
                            <small><p>{{ "account.time-zone-blurb"|trans }}</p></small>
                            <select id="timeZone" name="timeZone">
                                <option value="Asia/Tokyo"{% if (time_zone == "Asia/Tokyo" or time_zone == "+0900") %} selected{% endif %}>{{ "default-time-zone"|trans }}</option>
                                {% for zone in all_time_zones %}
                                {% if zone != "Asia/Tokyo" %}
                                <option value="{{ zone|e }}"{% if (zone == time_zone) %} selected{% endif %}>{{ zone }}</option>
                                {% endif %}
                                {% endfor %}
                            </select>
                            {% if ("timeZoneValue" in errors) %}
                            <small><p>{{ "invalid-time-zone-setting"|trans }}</p></small>
                            {% endif %}
                        </div>

<button type="submit" class="btn btn-primary">{{ "account.update-settings"|trans }}</button>
                    </form>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block body %}
	<div id="confirmPasswordRerollModal" class="modal fade" tabindex="-1" aria-labelledby="confirmPasswordRerollModalLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h1 id="confirmPasswordRerollModalLabel" class="modal-title fs-5">{{'account.reroll-log-in-password'|trans}}</h1>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					{{'account.reroll-confirm-message'|trans}}<br>
					{{'account.reroll-warning'|trans}}
				</div>
				<div class="modal-footer">
					<a href="reroll_password.php" class="btn btn-primary">{{'account.reroll-log-in-password'|trans}}</a>
				</div>
			</div>
		</div>
	</div>
	</div>
{% endblock %}
