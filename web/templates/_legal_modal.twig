{# Embedded legal document for signup, rendered from the same PageUtil::html Markdown as
   terms.php/privacy.php. It avoids duplicate text and remains readable without a second
   network request or losing form input. Expects id, title, body and href. #}
<div class="modal fade legal-modal" id="{{ id }}" tabindex="-1" aria-labelledby="{{ id }}Label" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h1 class="modal-title" id="{{ id }}Label">{{ title }}</h1>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="{{ 'close'|trans }}"></button>
			</div>
			<div class="modal-body legal-modal__body">
				{{ body|raw }}
			</div>
			<div class="modal-footer">
				{# Keep a standalone document URL for printing, saving and sharing. #}
				<a class="legal-modal__full" href="{{ href }}" target="_blank" rel="noopener">{{ 'open-full-page'|trans }}</a>
				<button type="button" class="btn btn-primary" data-bs-dismiss="modal">{{ 'close'|trans }}</button>
			</div>
		</div>
	</div>
</div>
